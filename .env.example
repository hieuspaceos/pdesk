# pdesk runtime credentials — copy this file to `.env` and fill in.
# `.env` is git-ignored. Never commit real keys.
#
# Two ways to provide these:
#   (a) put them in this file (or any parent .env) — loaded automatically
#   (b) export them in your shell before running `pdesk`
#
# The same values can also live in `~/.config/pdesk/pdesk.toml`:
#   SHEET_ID = "..."
#   SA_PATH  = "/path/to/sa.json"
#   MINIMAX_API_KEY = "..."

# Google Sheet ID — copy from the workbook URL between /d/ and /edit.
PDESK_SHEET_ID=

# Optional: which tab + range to read. Default is the user's "Chưa giải quyết" tab.
# Quote the tab name because it contains a space and a Unicode character.
PDESK_SHEET_RANGE='Chưa giải quyết'!A1:H1000

# Path to the service-account JSON key from Google Cloud Console.
# Share the target Sheet with the SA email as Viewer.
PDESK_SA_PATH=

# MiniMax API key. Provider is OpenAI-compatible, model is MiniMax-M3.
PDESK_MINIMAX_API_KEY=

# Optional overrides (defaults shown):
# PDESK_MINIMAX_MODEL=MiniMax-M3
# PDESK_DB_PATH=/Users/you/.local/share/pdesk/tasks.sqlite
